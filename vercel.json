{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "daemons": {
    "registry-bot": {
      "root": "workers/registry",
      "entrypoint": "Dockerfile",
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 30,
      "livenessProbe": {
        "httpGet": { "port": 1234, "path": "/health" },
        "initialDelaySeconds": 30,
        "periodSeconds": 30,
        "timeoutSeconds": 3,
        "failureThreshold": 3
      }
    }
  }
}
